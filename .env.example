# Absolute origin, no trailing slash. Canonical URLs, hreflang alternates,
# the sitemap and the Open Graph image URL are all derived from this.
NEXT_PUBLIC_SITE_URL=https://silkhire.ge

# --- Form backend (not wired up yet) -------------------------------------
# The route handlers in app/api/* currently validate and log. When you plug
# in a real destination, read its credentials from here — never from source.
# See README.md → "Where to plug in the form backend".

# RESEND_API_KEY=
# FORM_NOTIFICATION_EMAIL=hello@silkhire.ge
# CRM_WEBHOOK_URL=
